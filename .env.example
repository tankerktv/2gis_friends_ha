# Скопируй в .env и заполни. .env в git не коммитим (см. .gitignore).

# ---------- Токен ----------
# Это access_token 2ГИС: непрозрачная строка из 40 hex-символов (НЕ JWE).
# Берётся из query URL сокета в DevTools. Проверить живость:
#   python -m bridge.tokens
#
# static     — берём ZOND_TOKEN, при протухании меняем руками
# file       — читаем TOKEN_STORE (JSON: {"token":"...","expires_at":1753500000})
# playwright — headless-браузер сам достаёт токен из сохранённой сессии
TOKEN_PROVIDER=static
ZOND_TOKEN=
TOKEN_STORE=/data/token.json
PLAYWRIGHT_STORAGE_STATE=/data/storage_state.json
TWOGIS_FRIENDS_URL=https://2gis.ru/tomsk/friendsList
TOKEN_REFRESH_MARGIN=300

# ---------- zond WebSocket ----------
ZOND_WS_URL=wss://zond.api.2gis.ru/api/1.1/user/ws
ZOND_ORIGIN=https://2gis.ru
ZOND_APP_VERSION=6.31.0
ZOND_CHANNELS=markers,sharing,routes
ZOND_QUERY_PARAM=token

# Сервер фильтрует апдейты по области карты, поэтому она должна накрывать всех,
# кого хочешь видеть. Формат: верх_lat,лево_lon,низ_lat,право_lon
# По умолчанию — с запасом вокруг Томска.
ZOND_VIEWPORT=57.5,83.0,55.5,86.5
ZOND_VIEWPORT_ZOOM=11

# Keepalive: повторяем viewportChanged (отдельного ping в протоколе нет).
# friendsSocketIdleTimeout = 300000 мс, держим запас.
ZOND_WS_PING_INTERVAL=20
ZOND_KEEPALIVE_INTERVAL=120
ZOND_IDLE_TIMEOUT=900
ZOND_RECONNECT_MIN=2
ZOND_RECONNECT_MAX=120

# ---------- MQTT ----------
MQTT_HOST=mqtt.example.lan
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=2gis-friends-bridge
MQTT_BASE_TOPIC=2gis/friends
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_RETAIN=true

# ---------- Зона «дом» ----------
# Если заданы — мост сам считает home/not_home по радиусу.
# Если нет — состояние всегда not_home, зоны разруливай в HA.
HOME_LAT=
HOME_LON=
HOME_RADIUS=100

# ---------- Прочее ----------
LOG_LEVEL=INFO
# true — сыпать в лог каждый WS-фрейм (нужно на этапе разбора протокола)
LOG_FRAMES=false
